# Token bot dari Discord Developer Portal, BUKAN token akun pribadi.
DISCORD_BOT_TOKEN=
# Application ID, bukan Server ID.
CLIENT_ID=
GUILD_ID=

CHANNEL_REGISTER_ID=
ROLE_VERIFIED=
# Opsional. Beberapa ID dipisahkan koma. Manage Server juga mendapat akses admin.
ADMIN_ROLE_IDS=
CHANNEL_LOG_ID=
CHANNEL_WELCOME_ID=

# Tiket opsional: isi KEDUANYA untuk mengaktifkan.
TICKET_CATEGORY_ID=
TICKET_STAFF_ROLE_ID=

USERNAME_DB=root
PASSWORD_DB=
DATABASE_NAME=detroit
HOST_DB=127.0.0.1
PORT_DB=3306

# Status server opsional; hostname atau IPv4 yang dapat dijangkau bot.
GAME_HOST=
GAME_PORT=7777
QUERY_TIMEOUT_MS=3000
ROLE_SYNC_SECONDS=60
STATUS_UPDATE_SECONDS=60
CODE_COOLDOWN_SECONDS=60
# true memerlukan Server Members Intent di Developer Portal (welcome/rejoin).
ENABLE_MEMBER_EVENTS=false
